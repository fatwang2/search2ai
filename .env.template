# ===== search2ai 配置模板 =====
# 复制为 .env(本地 / Docker)或在 Workers 后台作为 Variables / Secrets 配置。
# 只需配置你要用的 provider; 未指定 SEARCH_SERVICE 时, 已配置的 provider 按默认优先级组成 fallback 链:
#   search1api → tavily → brave → exa → serper → serpapi → google → searxng

# --- 搜索 provider(至少配一个) ---
# 推荐: Search1API, 本项目配套的托管搜索服务, 一个 key 聚合 Google / Bing / DuckDuckGo 并支持抓取正文
# 注册免费送 100 积分: https://www.search1api.com/?utm_source=search2ai
SEARCH1API_KEY=
# SEARCH1API_SERVICE=google        # 底层引擎: google(默认) / bing / duckduckgo / yahoo / x / reddit / github / youtube / arxiv / wechat / bilibili / imdb / wikipedia

# TAVILY_KEY=
# BRAVE_KEY=
# EXA_KEY=
# SERPER_KEY=
# SERPAPI_KEY=
# GOOGLE_KEY=                        # Google Programmable Search, 需同时配置 GOOGLE_CX
# GOOGLE_CX=
# SEARXNG_BASE_URL=http://searxng:8080   # 自托管 SearXNG, 需在 settings.yml 开启 json 格式
# parallel 免 key, 无需变量: 把 parallel 写进 SEARCH_SERVICE 即启用搜索, 写进 CRAWL_SERVICE 则启用抓取

# --- 抓取 provider(可选; search1api / tavily / exa 自带抓取能力) ---
# JINA_KEY=                          # Jina Reader(r.jina.ai); 也可不填 key 而把 jina 写进 CRAWL_SERVICE
# FIRECRAWL_KEY=                     # Firecrawl 云端
# FIRECRAWL_BASE_URL=                # 自托管 Firecrawl 地址

# --- fallback 链(可选, 逗号分隔, 按顺序尝试) ---
# SEARCH_SERVICE=search1api,tavily,serper
# NEWS_SERVICE=search1api,serper
# CRAWL_SERVICE=search1api,jina

# --- 搜索参数(可选) ---
# MAX_RESULTS=10                     # 默认返回条数, 上限 50
# CRAWL_RESULTS=0                    # 默认对前 N 条结果抓取正文
# GL=us                              # 国家(Google 系 provider 的 gl)
# HL=en                              # 语言
# FALLBACK_ON_EMPTY=false            # 空结果也切换下一家(默认只在报错 / 限流 / 超时时切换)
# PROVIDER_TIMEOUT_MS=15000          # 单个 provider 超时
# CACHE_TTL=0                        # 结果缓存秒数, 0 关闭; Workers 上绑定名为 CACHE 的 KV 即用 KV, 否则进程内缓存

# --- 网关鉴权(可选) ---
# 逗号分隔的 Bearer key 列表; 配置后 /v1/* 与 /mcp 都需要携带 Authorization: Bearer <key>
# AUTH_KEYS=

# --- 兼容旧版: 聊天代理(可选, 配置 APIBASE 即挂载 /v1/chat/completions) ---
# 与 OpenAI SDK 的 baseURL 语义一致: 填 provider 文档里的完整前缀(host + 版本段)
# APIBASE=https://api.openai.com/v1
# OPENAI_TYPE=openai                 # openai(默认) | azure
# OPENAI_API_KEY=                    # 配置 AUTH_KEYS 后, 上游改用此 key
# RESOURCE_NAME= / DEPLOY_NAME= / API_VERSION= / AZURE_API_KEY=   # 仅 OPENAI_TYPE=azure

# --- 服务 ---
# PORT=3014
